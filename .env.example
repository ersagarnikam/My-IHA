# Settings for docker-compose.yml. Copy to .env (git-ignored) and fill in. Never commit real values.

# Where people open the portal, without a trailing slash. Also the API's allowed web origin.
PUBLIC_URL=http://localhost:8090
# Published port. WEB_BIND=127.0.0.1 keeps it on this machine; use 0.0.0.0 on a server.
WEB_BIND=127.0.0.1
WEB_PORT=8090
VITE_HOME_URL=https://medicaltourismaustralia.com

# Generate each one: openssl rand -base64 32
DATABASE_PASSWORD=
IHA_JWT_SECRET=
# Encrypts patient data. Losing or changing it makes that data unreadable: back it up.
IHA_PII_KEY=

# First MTA admin, created on start if the email doesn't exist. Password 12+ characters.
# Remove both once signed in.
IHA_ADMIN_EMAIL=
IHA_ADMIN_PASSWORD=

# stripe, or fake for simulated payments. Never fake in production.
IHA_PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Test with no accounts: uncomment these to use the local mailbox (http://localhost:8026) in place of
# Resend and Twilio, and fill the keys above with any text. Never in production.
# COMPOSE_PROFILES=mailbox
# RESEND_BASE_URL=http://mailbox:8025/resend
# TWILIO_BASE_URL=http://mailbox:8025/twilio

# Email (sign-up codes, alerts). The sender's domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=MTA <noreply@medicaltourismaustralia.com>

# SMS alerts. Optional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Also writes sign-up and password-reset codes to the API log, for testing without Resend
# (read them with: docker compose logs api). Never true in production.
IHA_VERIFICATION_LOGCODES=true

# Optional. Without these, consultations have no meeting link.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
